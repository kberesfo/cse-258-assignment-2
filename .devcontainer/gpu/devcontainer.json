// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
// GPU variant of ../devcontainer.json; keep the two in sync by hand.
{
    "name": "CSE 258 A2 (GPU)",
    "image": "mcr.microsoft.com/devcontainers/python:3-3.12-trixie",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/va-h/devcontainers-features/uv:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/devcontainers/features/nvidia-cuda:3": {
            "cudaVersion": "13.0"
        }
    },
    "containerEnv": {
        "DATA_DIR": "${containerWorkspaceFolder}/data",
        "A2_MODELS__BPR__USE_GPU": "true"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "tamasfe.even-better-toml",
                "ms-toolsai.datawrangler",
                "njpwerner.autodocstring",
                "tomoki1207.pdf",
                "charliermarsh.ruff",
                "redhat.vscode-yaml",
                "GitHub.vscode-pull-request-github"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "jupyter.notebookFileRoot": "${fileDirname}",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                },
                "notebook.defaultFormatter": "charliermarsh.ruff"
            }
        }
    },
    "runArgs": ["--gpus=all"],
    "postCreateCommand": "uv sync --locked --extra gpu && make setup",
    "remoteUser": "vscode"
}